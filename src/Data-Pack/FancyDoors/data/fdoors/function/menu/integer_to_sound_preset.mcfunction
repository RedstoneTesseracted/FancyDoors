execute if score fdoors.sound fdoors.local matches 14 run return run data modify storage fdoors:utility temp.sound set value "minecraft:entity.enderman.teleport"
execute if score fdoors.sound fdoors.local matches 1 run return run data modify storage fdoors:utility temp.sound set value "minecraft:block.fire.extinguish"
data modify storage fdoors:utility temp.sound set value "minecraft:entity.iron_golem.step"
