execute if score fdoors.sound fdoors.local matches 4 run return run data modify storage fdoors:utility temp.sound set value "minecraft:block.wooden_door.close"
execute if score fdoors.sound fdoors.local matches 5 run return run data modify storage fdoors:utility temp.sound set value "minecraft:block.wooden_door.open"
execute if score fdoors.sound fdoors.local matches 6 run return run data modify storage fdoors:utility temp.sound set value "minecraft:block.iron_door.close"
execute if score fdoors.sound fdoors.local matches 7 run return run data modify storage fdoors:utility temp.sound set value "minecraft:block.iron_door.open"
execute if score fdoors.sound fdoors.local matches 8 run return run data modify storage fdoors:utility temp.sound set value "minecraft:block.piston.contract"
