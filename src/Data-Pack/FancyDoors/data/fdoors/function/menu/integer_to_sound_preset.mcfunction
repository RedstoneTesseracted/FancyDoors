execute if score fdoors.sound fdoors.local matches 10 run return run data modify storage fdoors:utility temp.sound set value "minecraft:block.fence_gate.close"
execute if score fdoors.sound fdoors.local matches 11 run return run data modify storage fdoors:utility temp.sound set value "minecraft:block.fence_gate.open"
execute if score fdoors.sound fdoors.local matches 12 run return run data modify storage fdoors:utility temp.sound set value "minecraft:block.vault.close_shutter"
