# Converts an integer stored in fdoors.sound:fdoors.local to a sound string stored in fdoors:utility temp.sound

execute if score fdoors.sound fdoors.local matches 0 run return run data modify storage fdoors:utility temp.sound set value "minecraft:entity.iron_golem.step"
