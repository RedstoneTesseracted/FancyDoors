# Function macro called by the configuration dialog

$scoreboard players set fdoors.enable_barriers fdoors.config $(allow_barriers)
$scoreboard players set fdoors.enable_bedrock fdoors.config $(allow_bedrock)
$scoreboard players set fdoors.enable_block_entities fdoors.config $(allow_block_entities)
$scoreboard players set fdoors.regenerate_doors fdoors.config $(regenerate_doors)
