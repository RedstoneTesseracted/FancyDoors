{
    "type": "minecraft:confirmation",
    "title": {
        "translate": "fdoors.menu.transform.scale",
        "fallback": "Scale"
    },
    "body": {
        "type": "minecraft:plain_message",
        "contents": {
            "translate": "fdoors.menu.transform.scale.help",
            "fallback": "Display entity scale when in open state.  Results here will be divided by 10."
        }
    },
    "inputs": [
        {
            "type": "minecraft:number_range",
            "key": "x",
            "label": "10*X",
            "start": 0,
            "end": 99,
            "step": 1,
            "initial": 10
        },
        {
            "type": "minecraft:number_range",
            "key": "y",
            "label": "10*Y",
            "start": 0,
            "end": 99,
            "step": 1,
            "initial": 10
        },
        {
            "type": "minecraft:number_range",
            "key": "z",
            "label": "10*Z",
            "start": 0,
            "end": 99,
            "step": 1,
            "initial": 10
        }
    ],
    "can_close_with_escape": true,
    "yes": {
        "label": {
            "translate": "fdoors.menu.set",
            "fallback": "Set"
        },
        "action": {
            "type": "minecraft:dynamic/run_command",
            "template": "trigger fdoors.menu.transform.scale set $(x)0$(y)0$(z)"
        }
    },
    "no": {
        "label": {
            "translate": "fdoors.menu.cancel",
            "fallback": "Cancel"
        },
        "action": {
            "type": "minecraft:run_command",
            "command": "trigger fdoors.menu.transform.scale set -2147483647"
        }
    }
}